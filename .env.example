# =============================================================================
# Moneo - variabile publice (Vite) + referinte ops
# Copiaza in .env.local (gitignored). NICIODATA nu lipi service-role / webhook
# secrets aici sau in GitHub Actions ca VITE_*.
# =============================================================================

# --- Supabase (frontend, publice) ---
# Dashboard -> Project Settings -> API
# URL = project root only (fara /rest/v1/). Key = sb_publishable_… (sau legacy JWT anon).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Lemon Squeezy (frontend checkout - publice) ---
# Paste from Lemon dashboard. Upgrade opens checkout only when ALL four are
# set and CHECKOUT_URL is https. Missing any -> fail-closed (pay.unavailable).
# Store ID: Settings -> Stores
# Checkout URL: https://<slug>.lemonsqueezy.com/checkout  (fara trailing slash)
# Variant IDs: Products -> Pro Monthly/Yearly -> Variants -> Variant ID
# Preturi UI canonice: $5.99 / luna, $59.99 / an (src/lib/billing/pricingConfig.ts)
VITE_LEMONSQUEEZY_STORE_ID=your-store-id
VITE_LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout
VITE_LEMONSQUEEZY_MONTHLY_VARIANT_ID=your-monthly-variant-id
VITE_LEMONSQUEEZY_YEARLY_VARIANT_ID=your-yearly-variant-id

# Cloudflare Turnstile (Faza 32a — bot protection on signup/login).
# Public site key, safe in the client bundle. Optional: auth works
# without it, the widget just doesn't render. The matching secret key
# goes in Supabase Dashboard -> Authentication -> Settings -> Bot and
# Abuse Protection (Turnstile), never in this file.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Sentry (Faza 32c — error-only reporting, no session replay/analytics).
# Public DSN, safe in the client bundle (same trust level as a Sentry
# browser SDK's DSN anywhere else). Optional: without it, error
# reporting is a complete no-op — zero listeners, zero network calls.
VITE_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
# --- Email (optional FE gate) ---
# UI foloseste isEmailConfigured(); sendEmailNotification e fail-closed pana
# exista un backend real. Nu pune chei provider in VITE_*.
# VITE_EMAIL_API_URL=https://your-email-edge-or-worker.example/send

# --- Migratii locale / CI (NU sunt secrete de runtime FE) ---
# Access token: supabase.com -> Account -> Access Tokens (rol DB)
# Project ref: Dashboard -> Project Settings -> General -> Reference ID
SUPABASE_STAGING_PROJECT_REF=your-staging-project-ref
# SUPABASE_PRODUCTION_PROJECT_REF=your-production-project-ref
# SUPABASE_ACCESS_TOKEN=  # doar local CLI / CI secret - niciodata VITE_

# --- DNS check (scripts/check-dns.mjs) ---
CHECK_DOMAIN=moneo.bond
# EXPECT_CNAME=  # optional: pin CNAME asteptat in timpul migratiei

# =============================================================================
# Cloudflare Worker secrets (NU in .env Vite - doar wrangler secret put)
# Din cloudflare/workers/:
#   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   wrangler secret put LEMON_SQUEEZY_WEBHOOK_SECRET
#   wrangler secret put LEMON_SQUEEZY_API_KEY
#   wrangler secret put AI_API_KEY          # optional; fara el /api/ai/plan = fail-closed
# CORS_ORIGINS (optional):
#   default in cod = https://moneo.bond
#   staging: https://moneo.bond,http://localhost:5173
# Webhook URL de lipit in Lemon:
#   https://moneo.bond/api/webhook/lemonsqueezy
# Portal (self-serve): GET /api/billing/portal (JWT Supabase)
# =============================================================================

# --- Appearance / Pro fonts (no secrets) ---
# Font packs ship via @fontsource (bundled). Pro unlock is Lemon subscription
# state (auth.isPro) — no extra VITE_* for fonts, accents or light mode.

# --- Complimentary Pro (optional, non-secret allowlist) ---
# Permanent personal accounts: Free plan branding + full Pro entitlements
# (not Lemon-paid). Prefer editing COMPLIMENTARY_PRO_EMAILS in
# src/lib/billing/complimentaryPro.ts (and mirror in
# cloudflare/workers/complimentaryPro.ts). Or set comma-separated emails:
# VITE_PRO_COMPLIMENTARY_EMAILS=you@example.com,other@example.com
# Worker (same list, wrangler [vars] or secret put is overkill — use [vars]):
#   PRO_COMPLIMENTARY_EMAILS=you@example.com,other@example.com
# Restart Vite after changing .env.local. Redeploy worker after wrangler vars.
# VITE_PRO_COMPLIMENTARY_EMAILS=

# --- Libre / local AI (optional, fail-closed) ---
# Browser talks ONLY to this public base URL (typically local Ollama).
# No API keys in VITE_*. Empty / unreachable → rule-based assistant + local planner.
# VITE_AI_OLLAMA_URL=http://127.0.0.1:11434
# VITE_AI_OLLAMA_MODEL=llama3.2
