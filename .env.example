# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Lemon Squeezy Configuration
VITE_LEMONSQUEEZY_STORE_ID=your-store-id
VITE_LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout
VITE_LEMONSQUEEZY_MONTHLY_VARIANT_ID=your-monthly-variant-id
VITE_LEMONSQUEEZY_YEARLY_VARIANT_ID=your-yearly-variant-id
# Hosted customer portal (store settings -> General -> "My Orders" URL),
# used for the "Manage subscription" link. Leave unset to hide that button.
VITE_LEMONSQUEEZY_PORTAL_URL=https://your-store.lemonsqueezy.com/billing

# Error monitoring (optional — leave unset to disable entirely, zero
# network calls made). Create a free project at sentry.io, React platform,
# and paste its DSN here.
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
