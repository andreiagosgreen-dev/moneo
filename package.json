{
  "name": "moneo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:ci": "tsc --noEmit && vitest run && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"cloudflare/**/*.ts\" \"*.{js,json,md,yml}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"cloudflare/**/*.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "secret-scan": "node scripts/secret-scan.mjs",
    "perf-budget": "node scripts/perf-budget.mjs",
    "db:push:staging": "node scripts/db-push-staging.mjs"
  },
  "dependencies": {
    "@fontsource/cal-sans": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@supabase/supabase-js": "^2.98.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.7",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
